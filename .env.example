# ─────────────────────────────────────────────────────────────
# VisionDesk — variáveis de ambiente do backend
# Copie para .env e preencha. NUNCA versione o .env com chaves reais.
# ─────────────────────────────────────────────────────────────

# Chave da API Anthropic (obrigatória para os modos via VLM).
# O modo DESCREVER e os fallbacks de LER/CONTAR/ANALISAR usam o Claude.
ANTHROPIC_API_KEY=

# Modelo VLM (vision). Padrão recomendado: Claude Opus 4.8.
VISIONDESK_CLAUDE_MODEL=claude-opus-4-8

# Teto de tokens das respostas JSON do VLM (respostas são pequenas).
VISIONDESK_VLM_MAX_TOKENS=4096

# Banco SQLite (MVP). Em produção troque por PostgreSQL.
VISIONDESK_DB_PATH=./data/visiondesk.db

# Persistência de frames (privacidade/LGPD): por padrão NÃO salva imagens,
# apenas metadados/resultados. Ative apenas se necessário e autorizado.
VISIONDESK_PERSIST_FRAMES=false
VISIONDESK_FRAMES_DIR=./data/frames

# Servidor
VISIONDESK_HOST=0.0.0.0
VISIONDESK_PORT=8000

# CORS — origens permitidas (frontend Vite em dev).
VISIONDESK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Edge (opcional) — só usados se as dependências de edge estiverem instaladas.
VISIONDESK_YOLO_WEIGHTS=yolo11n.pt
VISIONDESK_YOLO_CONF=0.35
VISIONDESK_EDGE_DEVICE=mps

# ── Acesso ─────────────────────────────────────────────────────
# Toda rota /api/* e /ws/* exige sessão (login por PIN/crachá ou face); a
# sessão vai num cookie HttpOnly + SameSite=Strict (vd_session).
# Atalho "Entrar como DEV Admin": só em desenvolvimento local (e só de 127.0.0.1).
VISIONDESK_DEV_LOGIN=true
# Validade da sessão em horas (0 = sem expiração).
VISIONDESK_SESSION_TTL_HOURS=720
# Cookie Secure: vazio = automático (Secure quando o pedido chega por HTTPS).
# VISIONDESK_COOKIE_SECURE=true
# /docs, /redoc e /openapi.json: desligados por padrão. Ligue só em dev.
# VISIONDESK_EXPOSE_DOCS=true
