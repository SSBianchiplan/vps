# Aponte o backend p/ a stack de escala (docker compose up -d).
# Copie estas linhas no seu .env (raiz) e reinicie o backend.

# #2 — Postgres (eventos/dimensões). Requer migração da camada db/ (roadmap); provisionado.
VISIONDESK_DATABASE_URL=postgresql://visiondesk:visiondesk@localhost:5433/visiondesk

# #2 — Object store (frames/gravações → Image_URI s3://). Adapter já integrado (storage.py).
VISIONDESK_S3_ENDPOINT=http://localhost:9000
VISIONDESK_S3_BUCKET=visiondesk
AWS_ACCESS_KEY_ID=visiondesk
AWS_SECRET_ACCESS_KEY=visiondesk123

# #7 — MQTT (eventos → MES/SCADA). Publisher já integrado (integration/publish.py).
VISIONDESK_MQTT_URL=mqtt://localhost:1883
VISIONDESK_MQTT_TOPIC=visiondesk/events

# #3 — Media server (WebRTC/HLS fan-out). Endpoint /cameras/{id}/webrtc usa esta base.
VISIONDESK_RESTREAM_BASE=http://localhost:8889
